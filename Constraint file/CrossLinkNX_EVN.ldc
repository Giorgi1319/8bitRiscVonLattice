# Pre-synthesis constraints for the Lattice CrossLink-NX Evaluation Board (LIFCL-40-EVN)
# Top module: CrossLinkNX_Top

# 12 MHz board oscillator (jumper JP2 must be installed)
ldc_set_location -site {L13} [get_ports clk]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports clk]
create_clock -name {clk} -period 83.333 [get_ports clk]

# Reset: push button SW2, reads 0 when pressed
ldc_set_location -site {G14} [get_ports rst_n]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33 PULLMODE=UP} [get_ports rst_n]

# User LEDs (active-low): led_n[n] lights when register xn == n
ldc_set_location -site {E17} [get_ports {led_n[0]}]
ldc_set_location -site {F13} [get_ports {led_n[1]}]
ldc_set_location -site {G13} [get_ports {led_n[2]}]
ldc_set_location -site {F14} [get_ports {led_n[3]}]
ldc_set_location -site {L16} [get_ports {led_n[4]}]
ldc_set_location -site {L15} [get_ports {led_n[5]}]
ldc_set_location -site {L20} [get_ports {led_n[6]}]
ldc_set_location -site {L19} [get_ports {led_n[7]}]

ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led_n[0]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led_n[1]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led_n[2]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led_n[3]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led_n[4]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led_n[5]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led_n[6]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led_n[7]}]
