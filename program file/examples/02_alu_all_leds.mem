// ALU demo: uses all 8 ALU operations to build the values 1..7
// Result: LED1-LED7 all on (leds = 11111110)
0001_001_000_000001  // 0: ADDI x1, x0, 1       x1 = 1
0000_010_001_000_110  // 1: SHL  x2, x1          x2 = 1 << 1 = 2
0000_100_010_010_000  // 2: ADD  x4, x2, x2      x4 = 2 + 2 = 4
0000_110_100_010_011  // 3: OR   x6, x4, x2      x6 = 4 | 2 = 6
0000_011_110_000_111  // 4: SHR  x3, x6          x3 = 6 >> 1 = 3
0000_101_110_001_001  // 5: SUB  x5, x6, x1      x5 = 6 - 1 = 5
0000_111_110_001_100  // 6: XOR  x7, x6, x1      x7 = 6 ^ 1 = 7
0000_010_100_000_101  // 7: NOT  x2, x4          x2 = ~4 = 251 (LED2 off for a moment)
0000_010_010_110_010  // 8: AND  x2, x2, x6      x2 = 251 & 6 = 2 (LED2 on again)
0101_000_0_00000000  // 9: JAL  x0, 0           halt
