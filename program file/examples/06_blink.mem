0001_001_000_000001    //  0: ADDI x1, x0, 1     x1 = 1 (LED1 on)
0001_010_000_000001    //  1: ADDI x2, x0, 1     x2 = 1 (used to toggle x1)
0001_111_000_111110    //  2: ADDI x7, x0, -2    outer  = 254   <- blink loop
0001_101_000_111110    //  3: ADDI x5, x0, -2    middle = 254
0001_011_000_111110    //  4: ADDI x3, x0, -2    inner  = 254
0001_011_011_111110    //  5: ADDI x3, x3, -2    inner -= 2
0100_000_011_000_010   //  6: BEQ  x3, x0, +2    inner done? -> 8
0101_000_0_11111110    //  7: JAL  x0, -2        -> 5
0001_101_101_111110    //  8: ADDI x5, x5, -2    middle -= 2
0100_000_101_000_010   //  9: BEQ  x5, x0, +2    middle done? -> 11
0101_000_0_11111010    // 10: JAL  x0, -6        -> 4
0001_111_111_111110    // 11: ADDI x7, x7, -2    outer -= 2
0100_000_111_000_010   // 12: BEQ  x7, x0, +2    outer done? -> 14
0101_000_0_11110110    // 13: JAL  x0, -10       -> 3
0000_001_001_010_100   // 14: XOR  x1, x1, x2    toggle LED1
0101_000_0_11110011    // 15: JAL  x0, -13       -> 2 (repeat forever)